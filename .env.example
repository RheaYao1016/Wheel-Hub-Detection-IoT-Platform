# ==========================================
# Wheel-Hub-Detection-IoT-Platform 环境配置
# ==========================================
# 使用说明：
# 1. 复制此文件为 .env.local
# 2. 修改以下配置项为你的实际值
# 3. APP_SECURITY_SECRET 必须使用强随机字符串（建议32位以上）
# ==========================================

# 数据库连接（PostgreSQL）
# 本地开发可使用默认值，生产环境必须修改！
# 
# 连接池优化参数（附加到DATABASE_URL末尾）：
# - connection_limit: 连接池最大连接数，推荐公式: (CPU核心数 * 2) + 有效磁盘数
#   - 开发环境: 10
#   - 生产环境: 20-50（根据实际服务器配置调整）
# - pool_timeout: 连接池等待超时时间（秒），默认10
# - 示例: postgresql://user:password@localhost:5432/wheel_hub_platform?schema=public&connection_limit=20&pool_timeout=30
DATABASE_URL="postgresql://user:password@localhost:5432/wheel_hub_platform?schema=public&connection_limit=20&pool_timeout=30"

# Next.js 前端 -> Spring Boot 后端 API 地址
NEXT_PUBLIC_API_BASE_URL="http://localhost:18081/api"

# Spring Boot 后端 -> FastAPI AI/ML 服务地址
APP_AI_ML_BASE_URL="http://localhost:18100"

# 共享数据目录（上传文件、报告、训练模型等）
APP_DATA_HOME="./backend/data"

# 加密密钥（用于加密Provider API Keys）
# ⚠️ 生产环境必须修改为强随机字符串（至少32位字符）
# 建议使用: openssl rand -base64 32 生成
APP_SECURITY_SECRET="wheel-hub-platform-secret-CHANGE-IN-PRODUCTION"

# 演示账户开关（生产环境建议设置为 false）
# NEXT_PUBLIC_ENABLE_DEMO_ACCOUNTS="true"

# 后端服务端口
SERVER_PORT=18081

# 前端服务端口
PORT=3001

# AI/ML 服务端口
AI_ML_PORT=18100

# CORS 配置
APP_CORS_ALLOWED_ORIGINS="http://localhost:3001"

# ==========================================
# Sentry 性能监控配置
# ==========================================
# 获取DSN: https://sentry.io/settings/projects/
# 前端 DSN (公开，用于浏览器端错误上报)
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/your-project-id"

# Sentry 环境标识
NEXT_PUBLIC_SENTRY_ENVIRONMENT="development"

# 性能追踪采样率 (0.0-1.0)
# 生产环境建议 0.1 (10%)，开发环境可设为 1.0 (100%)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# 性能分析采样率
NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE="0.1"

# 会话回放采样率
NEXT_PUBLIC_SENTRY_REPLAYS_SAMPLE_RATE="0.1"

# 后端 Sentry DSN (保密，不要暴露到前端)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_PROFILES_SAMPLE_RATE="0.1"
