# Default local database (SQLite). The current Prisma schema is configured for SQLite.
# To use PostgreSQL in production, update prisma/schema.prisma provider to "postgresql"
# and set DATABASE_URL to a postgresql:// connection string.
DATABASE_URL="file:./backend/data/platform.db"

# Next.js -> Spring Boot
NEXT_PUBLIC_API_BASE_URL="http://localhost:18081/api"

# Spring Boot server port
SERVER_PORT="18081"

# Spring Boot -> FastAPI AI/ML service
APP_AI_ML_BASE_URL="http://127.0.0.1:18100"

# Shared workspace for uploads, reports and training artifacts
APP_DATA_HOME="./backend/data"

# CORS origins allowed by the backend
APP_CORS_ALLOWED_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"

# Session lifetime in hours
APP_AUTH_SESSION_HOURS="12"

# Secret used for encrypting provider API keys (must be at least 16 characters)
APP_SECURITY_SECRET="wheel-hub-platform-secret"

# Enable seeded demo accounts (admin-demo, engineer-demo, operator-demo, viewer-demo)
APP_DEMO_ENABLED="true"

# AI/ML service workspace (used by the Python service)
AI_ML_WORKSPACE="./backend/data/ai-ml"
