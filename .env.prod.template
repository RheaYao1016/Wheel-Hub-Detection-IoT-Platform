# ============================================================
# Production Environment Variables Template
# Usage: Copy to .env.prod and fill in real values before deploying
#   cp .env.prod.template .env.prod
# ============================================================

# --- Database ---
DB_USER=wheel_hub_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD_$(openssl rand -base64 32)
DB_NAME=wheel_hub_platform

# --- Application Security ---
APP_SECURITY_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_$(openssl rand -base64 32)

# --- CORS ---
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=/api

# --- Timezone ---
TZ=Asia/Shanghai
